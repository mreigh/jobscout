# Copy to .env and fill in. .env is gitignored.

# Claude API key for fit scoring (needed from E5 onward)
ANTHROPIC_API_KEY=

# Where JobScout keeps its local SQLite database
JOBSCOUT_DB_PATH=data/jobscout.db

# Folder holding filters.yaml (and later watchlist.csv)
JOBSCOUT_CONFIG_DIR=config

# Folder for structured log files
JOBSCOUT_LOG_DIR=logs

# DEBUG, INFO, WARNING, ERROR
JOBSCOUT_LOG_LEVEL=INFO
